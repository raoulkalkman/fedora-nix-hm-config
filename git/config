[core]
    excludesfile = ~/.config/git/.gitignore
    quotepath = false
    pager = delta
	editor = nvim
	autocrlf = true
	whitespace = trailing-space,space-before-tab,indent-with-non-tab,-tab-in-indent,cr-at-eol

[interactive]
	diffFilter = delta

[delta]
	features = line-numbers decorations
	syntax-theme = Catppuccin Mocha
	navigate = true
	pager = ov -F --section-delimiter '^commit ' --section-header

[merge]
	conflictstyle = zdiff3
	tool = meld
[user]
	name = Raoul Kalkman
	email = raoulkalkman@outlook.com
[init]
	defaultBranch = main
[diff]
	guitool = meld
[help]
	autocorrect = 1
